<div class="recent-posts">
  <h2 class="recent-posts-title">
    <a href="{{ '/blog/' | relative_url }}">new blog post</a>
  </h2>
  <hr class="recent-posts-divider" />
  {% if site.latest_posts != blank and site.posts != blank %}
    {% assign latest_posts_size = site.posts | size %}
    {% if site.latest_posts.limit %}
      {% assign latest_posts_limit = site.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}
    <ul class="recent-posts-list">
      {% for item in site.posts limit: latest_posts_limit %}
        {% assign blurb = item.card_blurb | default: item.description %}
        {% assign link_text = item.card_link_text | default: 'read more →' %}
        <li>
          {{ blurb }}
          {% if item.redirect contains '://' %}
            <a class="recent-posts-link" href="{{ item.redirect }}" target="_blank" rel="noopener">{{ link_text }}</a>
          {% elsif item.redirect != blank %}
            <a class="recent-posts-link" href="{{ item.redirect | relative_url }}">{{ link_text }}</a>
          {% else %}
            <a class="recent-posts-link" href="{{ item.url | relative_url }}">{{ link_text }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
